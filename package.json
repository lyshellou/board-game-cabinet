{
  "name": "board-game-cabinet",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --experimental-sqlite --watch --import tsx src/index.ts",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "start": "cd server && node --experimental-sqlite --import tsx src/index.ts",
    "seed": "cd server && node --experimental-sqlite --import tsx src/db/seed.ts"
  }
}
